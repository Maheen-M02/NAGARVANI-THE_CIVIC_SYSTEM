# Supabase Configuration (required)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CLIP API URL (Hugging Face Spaces)
REACT_APP_CLIP_API_URL=https://YOUR-HF-USERNAME-nagarvani-clip.hf.space

# Vapi Voice AI (get from https://vapi.ai → Dashboard → API Keys)
REACT_APP_VAPI_PUBLIC_KEY=your_vapi_public_key_here
REACT_APP_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
REACT_APP_VAPI_PHONE_NUMBER=+1-800-000-0000

# Supabase Service Role Key (for server-side API only — NEVER expose to frontend)
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
